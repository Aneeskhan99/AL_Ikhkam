# Copy this file to .env.local and fill in the values.
# .env.local holds secrets: never commit it, never paste it into chat.

# Public address of the site (sitemap, canonical links, social previews, links in emails)
NEXT_PUBLIC_SITE_URL=http://192.168.90.152:3005

# PostgreSQL connection for the admin panel. Without it the public site still runs from the built-in content,
# but the admin panel and the enquiry inbox are unavailable.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/al_ihkam
# DB_POOL_MAX=5

# Uploaded images and PDFs live here, outside the code folder, so a redeploy never deletes them.
MEDIA_DIR=/home/dev1/apps/al-ihkam-media

# First administrator, created by "npm run setup" only when no administrator exists yet.
# Change the password from Admin › My account after the first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# ADMIN_EMAIL=

# Session cookie. Leave unset: it is marked Secure automatically when the site is served over https.
# Set to "true" to force it once the site is behind HTTPS.
# COOKIE_SECURE=true

# If the admin team's proxy serves the site under a different host name, list it here
# (comma separated) so admin forms are accepted, for example: al-ihkam.com,www.al-ihkam.com
# ADMIN_ALLOWED_ORIGINS=

# Email for consultation requests and enquiry assignments. Optional: every request is saved under
# Admin › Enquiries either way. Recipients are set in Admin › Settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Al-Ihkam <no-reply@al-ihkam.com>"
# Fallback recipient before anyone has saved Admin › Settings
CONTACT_TO_EMAIL=zeeshanraees2015@gmail.com
